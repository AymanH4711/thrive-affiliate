# ============================================
# EMAIL SERVICE (EmailJS Configuration)
# ============================================
# Get these from your EmailJS dashboard:
# https://dashboard.emailjs.com/

# Lead-magnet service/template (7-day guide, full book)
VITE_EMAILJS_SERVICE_ID_LEADMAGNET=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID_LEADMAGNET=your_emailjs_template_id

# Contact-form service/template
VITE_EMAILJS_SERVICE_ID_CONTACT=your_emailjs_contact_service_id
VITE_EMAILJS_TEMPLATE_ID_CONTACT=your_emailjs_contact_template_id

# Backward-compatible aliases
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id

# Your EmailJS Public Key
# Example: jIg8H78CXxzH5v9ya
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# ============================================
# BOT PROTECTION (Cloudflare Turnstile)
# ============================================
# Create a Turnstile widget:
# https://dash.cloudflare.com/?to=/:account/turnstile
#
# The site key is public and belongs in the browser build.
# The secret key is server-side ONLY: set TURNSTILE_SECRET_KEY in
# Cloudflare Pages -> Settings -> Variables and Secrets -> Production.
# Never prefix the secret with VITE_.
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# ============================================
# SERVER-SIDE EMAIL (Cloudflare Pages Functions)
# ============================================
# The Functions send the lead-magnet and contact emails after Turnstile
# verification. The VITE_ EmailJS values above are accepted as fallbacks, but
# these explicit names are clearer. Set them in Cloudflare Pages, not in a
# public browser build.
#
# EMAILJS_PUBLIC_KEY=your_emailjs_public_key
# EMAILJS_PRIVATE_KEY=your_emailjs_private_key   # optional but recommended
# EMAILJS_SERVICE_ID_LEADMAGNET=your_emailjs_service_id
# EMAILJS_TEMPLATE_ID_LEADMAGNET=your_emailjs_template_id
# EMAILJS_SERVICE_ID_CONTACT=your_emailjs_contact_service_id
# EMAILJS_TEMPLATE_ID_CONTACT=your_emailjs_contact_template_id

# ============================================
# OPTIONAL: ANALYTICS
# ============================================
# Get this from Google Analytics:
# https://analytics.google.com/

# Your Google Analytics Measurement ID
# Example: G-XXXXXXXXXX
VITE_GA_ID=G-your_measurement_id

# ============================================
# OPTIONAL: AFFILIATE TRACKING
# ============================================

# Your Digistore24 affiliate ID
VITE_DIGISTORE_AFFILIATE_ID=your_affiliate_id

# Your iHerb affiliate code (if using)
VITE_IHERB_AFFILIATE_CODE=your_iherb_code

# ============================================
# OPTIONAL: CONTACT LIST (Brevo)
# ============================================
# These are SERVER-SIDE ONLY. Set them in Cloudflare Pages environment
# variables; never prefix the Brevo key with VITE_ (that would expose it
# in the browser bundle).
# Get the key from: https://app.brevo.com/settings/api-keys

BREVO_API_KEY=your_brevo_api_key
BREVO_LIST_ID=3

# ============================================
# NOTES
# ============================================
# - For production, set VITE_TURNSTILE_SITE_KEY and TURNSTILE_SECRET_KEY
#   in Cloudflare Pages. The secret must never be VITE_-prefixed or committed.
# - EmailJS and Brevo values are still needed for lead capture and email.
# - Never commit .env.local (has real secrets)
# - .env.example is safe to commit (has placeholders)
# - When setting up on a new machine:
#   1. Copy .env.example to .env.local
#   2. Replace placeholder values with real values
#   3. Never commit .env.local to git
